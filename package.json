{
  "name": "first-million",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @fm/web build",
    "bundle:check": "pnpm --filter @fm/web check:dist",
    "e2e": "pnpm --filter @fm/e2e e2e",
    "lighthouse": "pnpm --filter @fm/web lighthouse",
    "dev:auth": "pnpm dlx firebase-tools@15.33.0 emulators:start --only auth --project demo-first-million --config tools/auth-emulator/firebase.json",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1"
  }
}
