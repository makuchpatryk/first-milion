# Vite reads VITE_* at build time; this file itself is never loaded.

# --- Development: demo values for the Firebase Auth emulator (PRD §20 #35) ---
# Copy to .env.development.local. The emulator hook runs only in `vite` dev (import.meta.env.DEV).
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_PROJECT_ID=demo-first-million
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_WORKER_URL=http://127.0.0.1:8787

# --- Production: set as GitHub environment `production` variables (deploy.yml), not in a file ---
# They are public web config. VITE_AUTH_EMULATOR_URL must stay unset there; `pnpm bundle:check`
# fails the deploy if the build carries it.
# VITE_FIREBASE_API_KEY=<Web API key of the Firebase project>
# VITE_FIREBASE_PROJECT_ID=<Firebase project id>
# VITE_WORKER_URL=https://<worker>.<account>.workers.dev
